# =============================================================================
# {{BRAND_NAME}} — environment template (spec Appendix A)
#
#   cp .env.example .env      then edit. Never commit real values.
#
# Rules:
#   · No secret ever goes in a NEXT_PUBLIC_* variable — those are inlined into
#     client JavaScript and are public by definition.
#   · Capability flags are DERIVED FROM CREDENTIAL PRESENCE, not from a boolean
#     you can flip. A partial credential group leaves the capability off, which
#     is the correct failure mode (ADR-0014).
#   · Values containing "{{" are treated as unset by src/lib/brand.ts, so an
#     unresolved template placeholder never reaches the UI.
#
# Read by: src/lib/brand.ts, src/lib/checkout.ts, src/lib/money.ts,
#          src/lib/metadata.ts, src/app/api/v1/*
# A single validated config module (src/config/env.ts) is Phase 2 work.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
APP_REGION=BD

# --- Brand (D15 gate — see src/lib/brand.ts evidence log) -------------------
# "Nexora" is taken (US Reg. #7833669 + DCC Technology group rebrand, Dec 2025).
# "Scholarix" was retired by the client. Pick and CLEAR a name before setting
# BRAND_CLEARED=true; until then the UI shows a provisional-name warning and no
# logo asset may be produced.
BRAND_NAME={{BRAND_NAME}}
BRAND_SLUG=marketplace
BRAND_TAGLINE=Think Smarter. Achieve More.
BRAND_MONOGRAM=
BRAND_CLEARED=false

# Persistent "DEMO DATA" ribbon + labelled sample figures (§6 rule 13).
# Must be false in production.
DEMO_MODE=true

# --- Public URL & SEO (§21.1) ----------------------------------------------
# Drives metadataBase, canonical URLs, sitemap.xml and all JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set false on any non-production host so robots.txt disallows everything.
NEXT_PUBLIC_ROBOTS_INDEX=false

# --- Data layer (ADR-0013) --------------------------------------------------
# "static" = seeded fixtures behind the repository seam (no database needed)
# "prisma" = PostgreSQL via packages/database  →  docker compose up -d postgres
DATA_ADAPTER=static
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
DIRECT_DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

# --- Redis / BullMQ (§17.5) -------------------------------------------------
# Queues, rate limiting, webhook idempotency cache. Without it, duplicate
# callback protection and fulfilment job claiming cannot run — a launch blocker.
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=marketplace

# --- Auth.js v5 (§17.6 — all seven settings are mandatory) ------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# DATABASE sessions, not JWT: a revoked session must stop working immediately.
AUTH_SESSION_STRATEGY=database
# Argon2id m=64MB, t=3, p=4
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
MFA_ISSUER=
# TOTP is mandatory for SUPER_ADMIN and FINANCE.
SESSION_IDLE_HOURS_CUSTOMER=24
SESSION_IDLE_HOURS_ADMIN=8
SESSION_ABSOLUTE_DAYS=30

# --- Money (§1.1, §13.3, §13.8) --------------------------------------------
# All amounts are INTEGER POISHA (1 BDT = 100 poisha). Never a float.
# VAT in basis points (500 = 5%). LEFT AT 0 until D5 (VAT treatment) is decided
# by counsel — guessing a rate on an invoice is a tax problem, not a rounding one.
VAT_RATE_BP=0
# Student step, basis points. INERT unless STUDENT_VERIFICATION_PROVIDER is also
# set: an unverified shopper must never receive the discount.
STUDENT_DISCOUNT_BP=1000
STUDENT_VERIFICATION_PROVIDER=
# Floor that stacked discounts can never pass, in poisha.
PRICE_FLOOR_POISHA=0
# Coupon service. Without it, a coupon code in the URL is reported as not applied.
COUPON_SERVICE_URL=

# --- Encryption -------------------------------------------------------------
# Code-vault ciphertext and TOTP secrets are encrypted at rest (§6 rule 8).
FULFILLMENT_ENCRYPTION_KEY=

# --- Object storage (S3-compatible: MinIO / Azure Blob / R2) ----------------
# Private bucket + per-file ACL + short-lived signed URLs + audited downloads.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_CDN_URL=
FILE_SIGNED_URL_TTL_SECONDS=300
FILE_MAX_SIZE_MB=25

# --- Payments (§19.4) -------------------------------------------------------
# Set a COMPLETE group or none. Only licensed Bangladeshi PSPs (Bangladesh Bank
# MFS-PSPD). Never collect or store a card number, PIN or OTP.
#
# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_WEBHOOK_SECRET=
#
# bKash
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
#
# Nagad
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
#
# Manual bank transfer — dual approval above the threshold.
ALLOW_MANUAL_PAYMENT=false
MANUAL_PAYMENT_DUAL_APPROVAL_ABOVE_POISHA=500000

# --- Transactional email ----------------------------------------------------
# SMTP is the portable option and is what docker-compose's mailpit profile
# serves locally (SMTP_HOST=mailpit, SMTP_PORT=1025, UI on :8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@marketplace.local
MAIL_REPLY_TO=support@marketplace.local
# Hosted alternative (Phase 4). If set, EMAIL_PROVIDER wins over SMTP.
EMAIL_PROVIDER=
EMAIL_API_KEY=

# --- Observability (§17.7) --------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Analytics (D10 — provider not yet chosen) ------------------------------
ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Feature flags ----------------------------------------------------------
FEATURE_AFFILIATES=false
FEATURE_REVIEWS=false
FEATURE_STUDENT_VERIFICATION=false
# Bangla typography is loaded and the token exists; content rollout is D16.
FEATURE_I18N_BN=false

# --- Build ------------------------------------------------------------------
# Set to "standalone" for the Docker image (see apps/web/Dockerfile).
NEXT_BUILD_OUTPUT=
# Bound the heap on machines under ~2 GB.
NODE_OPTIONS=--max-old-space-size=1024
